// Settings shared by every flavor of the app target.
// Flavor files (Beta / Prod) include this and override the flavor-specific values.

APP_NAME = RecQuest
BASE_BUNDLE_ID = com.nameisjayant.Screen-Recorder

PRODUCT_BUNDLE_IDENTIFIER = $(BASE_BUNDLE_ID)$(BUNDLE_ID_SUFFIX)
ASSETCATALOG_COMPILER_APPICON_NAME = $(APP_ICON_NAME)

INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.video
INFOPLIST_KEY_UIUserInterfaceStyle = Dark

// Privacy strings for the upcoming recording features.
INFOPLIST_KEY_NSCameraUsageDescription = RecQuest uses the front camera to show your face cam bubble while you record.
INFOPLIST_KEY_NSMicrophoneUsageDescription = RecQuest uses the microphone to capture your live commentary.
INFOPLIST_KEY_NSPhotoLibraryAddUsageDescription = RecQuest saves your finished recordings to your photo library.
